from sklearn import datasets  # 加载数据集
iris = datasets.load_iris()
X = iris.data
y = iris.target#这里是在加载鸢尾花数据集，并将特征数据存储在X中，标签数据存储在y中。
#特征数据和标签数据分别是鸢尾花数据集中的花萼长度、花萼宽度、花瓣长度和花瓣宽度，以及对应的花的类别（Setosa、Versicolor、Virginica）。

from sklearn.preprocessing import StandardScaler#这个库和函数是用来对数据进行标准化处理的。标准化是将数据转换为均值为0，标准差为1的分布，这样可以使得不同特征的数据在同一尺度上进行比较，避免某些特征因为数值范围较大而对模型产生过大的影响。
scaler = StandardScaler()#怎么区分类和函数和方法,答：
X_scaled = scaler.fit_transform(X)#这里是对特征数据X进行标准化处理。首先创建一个StandardScaler对象，然后使用fit_transform方法将X进行标准化，得到标准化后的数据X_scaled。

from sklearn.cluster import KMeans#cluter是聚类分析的库，KMeans是其中的一种聚类算法。KMeans算法通过将数据点分成k个簇来进行聚类，每个簇由一个中心点（质心）代表，算法的目标是最小化簇内数据点与质心之间的距离。
#sklearn是一个常用的机器学习库，提供了各种算法和工具来进行数据分析和建模。通过导入KMeans类，我们可以使用KMeans算法来对数据进行聚类分析。
#sklearn和cluster库的关系是，sklearn是一个包含多个机器学习算法和工具的库，而cluster是sklearn中的一个子模块，专门用于聚类分析。KMeans是cluster模块中的一个类，用于实现K-Means聚类算法。
#sklearn和cluster都是库，sklearn是一个更大的库，包含了多个子模块，其中cluster是其中一个子模块，专门用于聚类分析。KMeans是cluster模块中的一个类，用于实现K-Means聚类算法。
# 错误1：n_cluster 应该是 n_clusters（少了s）
kmeans = KMeans(n_clusters=3, random_state=42)#n_clusters参数指定了要形成的簇的数量，这里设置为3，表示我们希望将数据分成3个簇。random_state参数用于设置随机数生成器的种子，以确保每次运行代码时得到相同的结果。 
#这里是否可以用肘部法来确定最佳的簇数量？答：是的，可以使用肘部法来确定最佳的簇数量。肘部法通过计算不同簇数量下的聚类性能指标（如簇内误差平方和）来评估聚类效果，并选择在性能指标下降明显的点作为最佳簇数量。在这个例子中，我们已经指定了n_clusters=3，但如果不确定最佳簇数量，可以使用肘部法来进行选择。
#一定要random_state=42吗？答：不一定，random_state参数是用来控制随机数生成器的种子，以确保每次运行代码时得到相同的结果。如果你希望每次运行代码时得到不同的聚类结果，可以将random_state设置为None或者不设置该参数。但如果你希望在不同的运行中得到相同的聚类结果，建议设置一个固定的随机种子，例如random_state=42。
#那其他 种子 分别有啥 特性，答：不同的随机种子会导致不同的聚类结果，因为KMeans算法在初始化质心时使用了随机数生成器。每个随机种子都会产生不同的初始质心位置，从而影响最终的聚类结果。没有特定的种子具有特殊的特性，选择哪个种子取决于你的需求和实验设计。如果你希望得到可重复的结果，可以选择一个固定的种子，例如random_state=42；如果你希望探索不同的聚类结果，可以尝试使用不同的随机种子。
#一定是42吗感觉这个很常见，答：42是一个常见的随机种子值，因为它在编程社区中被广泛使用，并且被认为是一个“幸运数字”。然而，选择随机种子值并没有特定的规则或要求，你可以选择任何整数作为随机种子。重要的是要确保在需要可重复结果的情况下使用相同的随机种子，以便在不同的运行中得到相同的聚类结果。
#为什么42是幸运数，答：42被认为是一个幸运数字，主要是因为它在文学和流行文化中具有特殊的意义。最著名的例子是道格拉斯·亚当斯的科幻小说《银河系漫游指南》（The Hitchhiker's Guide to the Galaxy），其中42被描述为“生命、宇宙以及一切问题的终极答案”。这个概念使得42成为了一个象征性的数字，代表着神秘和未知的答案。因此，许多人将42视为一个幸运数字，尤其是在编程和数学领域。
kmeans.fit(X_scaled)#这一步是对标准化后的数据X_scaled进行K-Means聚类分析。fit方法会计算出每个簇的质心，并将数据点分配到最近的质心所在的簇中。通过调用fit方法，KMeans算法会根据指定的簇数量（n_clusters=3）对数据进行聚类，并计算出每个簇的中心位置。
y_kmeans = kmeans.predict(X_scaled)#这一步是使用训练好的KMeans模型对标准化后的数据X_scaled进行预测，得到每个数据点所属的簇的标签。predict方法会根据每个数据点与质心之间的距离，将数据点分配到最近的簇中，并返回一个包含每个数据点所属簇标签的数组y_kmeans。

# 可视化
import matplotlib.pyplot as plt#这是一个常用的绘图库，用于创建各种类型的图表和可视化数据。通过导入matplotlib.pyplot模块，我们可以使用其中的函数来绘制散点图、线图、柱状图等，以便更好地理解和展示数据。 
plt.figure(figsize=(12, 5))#figsize参数指定了图表的大小，这里设置为宽12英寸，高5英寸。通过调整图表的大小，可以更清晰地展示数据和结果。
plt.subplot(121)#这一步是创建一个包含两个子图的图表，并指定当前操作的是第一个子图（121表示1行2列的第1个子图）。在这个子图中，我们将绘制原始数据的散点图，以展示真实的标签分布。
#那第一行第一列的子图呢？答：第一行第一列的子图是指在一个包含多个子图的图表中，位于第一行第一列位置的子图。在这个例子中，我们使用plt.subplot(121)来指定当前操作的是第一个子图，即第一行第一列的子图。这个子图将用于绘制原始数据的散点图，以展示真实的标签分布。第二个子图（122）则用于绘制K-Means聚类结果的散点图。
plt.scatter(X[:, 0], X[:, 1], c=y, cmap='viridis')#这一行代码是用来绘制原始数据的散点图。X[:, 0]表示数据集中的第一列特征（花萼长度），X[:, 1]表示第二列特征（花萼宽度）。c=y表示根据真实标签y来为每个数据点着色，cmap='viridis'指定了使用Viridis颜色映射来显示不同的类别。通过这行代码，我们可以可视化原始数据的分布和类别之间的关系。
#具体讲一下绘制散点图的参数和作用：
#X[:, 0]：表示数据集中的第一列特征（花萼长度），作为散点图的x轴坐标。
#X[:, 1]：表示数据集中的第二列特征（花萼宽度），作为散点图的y轴坐标。
#c=y：表示根据真实标签y来为每个数据点着色，不同的类别会有不同的颜色。
#cmap='viridis'：指定了使用Viridis颜色映射来显示不同的类别，Viridis是一种渐变色调的颜色映射，可以更好地区分不同的类别。   
#生成的121 和122 有什么区别：121和122是plt.subplot函数中的参数，用于指定当前操作的子图位置。121表示1行2列的第1个子图，即第一行第一列的子图；122表示1行2列的第2个子图，即第一行第二列的子图。在这个例子中，121用于绘制原始数据的散点图，而122用于绘制K-Means聚类结果的散点图。通过使用不同的参数，我们可以在同一图表中创建多个子图来展示不同的数据和结果。
#121原始数据散点图的颜色划分是怎么分的，答：121原始数据散点图的颜色划分是根据真实标签y来进行的。每个数据点的颜色由其对应的标签值决定，不同的标签值会被映射到不同的颜色。cmap='viridis'指定了使用Viridis颜色映射，这是一种渐变色调的颜色映射，可以更好地区分不同的类别。因此，在散点图中，不同类别的数据点会显示为不同的颜色，帮助我们更清晰地看到数据的分布和类别之间的关系。
plt.title('True Labels')#这行代码是用来设置第一个子图的标题为“True Labels”，以便更清晰地说明这个子图展示的是原始数据的真实标签分布。标题可以帮助观众理解图表的内容和目的。
plt.xlabel('Sepal Length(cm)')#这行代码是用来设置第一个子图的x轴标签为“Sepal Length(cm)”，以便更清晰地说明x轴表示的是花萼长度（单位为厘米）。标签可以帮助观众理解图表中每个轴所代表的含义。
plt.ylabel('Sepal Width(cm)')#这行代码是用来设置第一个子图的y轴标签为“Sepal Width(cm)”，以便更清晰地说明y轴表示的是花萼宽度（单位为厘米）。标签可以帮助观众理解图表中每个轴所代表的含义。

plt.subplot(122)#这行代码是用来指定当前操作的是第二个子图（122表示1行2列的第2个子图）。在这个子图中，我们将绘制K-Means聚类结果的散点图，以展示聚类算法对数据的分类效果。通过使用plt.subplot(122)，我们可以在同一图表中创建多个子图来展示不同的数据和结果。
# 错误2：一行不能同时写 scatter + 画中心点；错误3：marker='' 是空的，不显示
plt.scatter(X[:, 0], X[:, 1], c=y_kmeans, cmap='viridis')
# 错误4：画聚类中心要单独一行，且用缩放后的中心
centers = scaler.inverse_transform(kmeans.cluster_centers_)
plt.scatter(centers[:, 0], centers[:, 1], c='red', s=200, marker='*', label='Centroids')

plt.title('K-Means Clustering Results')#cluster中文：聚类
plt.xlabel('Sepal Length(cm)')
plt.ylabel('Sepal Width(cm)')
plt.legend()#legend是用来显示图例的函数。在这个例子中，我们在绘制聚类中心时使用了label='Centroids'参数，这会为聚类中心添加一个标签。当我们调用plt.legend()时，图例会显示这个标签，帮助观众识别图中的不同元素。在这个例子中，图例会显示一个红色的星形标记，表示聚类中心的位置。
plt.show()